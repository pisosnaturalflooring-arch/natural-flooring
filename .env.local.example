# Copiá este archivo como ".env.local" y completá los valores reales.
# .env.local está en .gitignore: NO se sube al repo.

# ── Visualizador de pisos (OpenAI) ───────────────────────────────────────────
# https://platform.openai.com/api-keys
# Key restringida, con Model capabilities → Images = Request y Responses =
# Request. Responses es para el chequeo previo que descarta fotos sin piso.
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: modelo chico del chequeo previo, si el default no sirve.
OPENAI_VISION_MODEL=gpt-4o-mini

# ── Base de leads (Turso) ────────────────────────────────────────────────────
# turso db create natural-flooring && turso db show --url natural-flooring
# turso db tokens create natural-flooring
TURSO_DATABASE_URL=libsql://natural-flooring-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Aviso por mail de cada lead (Resend) ─────────────────────────────────────
# https://resend.com/api-keys — opcional: sin esto el lead igual se guarda.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
LEADS_NOTIFY_EMAIL=pisosnaturalflooring@gmail.com
# Con dominio propio verificado en Resend, cambiá el remitente:
LEADS_FROM_EMAIL=onboarding@resend.dev

# ── Lectura de leads: GET /api/leads (y ?format=csv) ─────────────────────────
# Inventá una cadena larga y aleatoria: openssl rand -hex 32
LEADS_ADMIN_TOKEN=
